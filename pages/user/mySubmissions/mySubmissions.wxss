/* pages/user/mySubmissions/mySubmissions.wxss - 简约风格 */
page {
  background-color: #f5f7fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.page-container {
  min-height: 100vh;
}

.content-wrapper {
  padding: 40rpx;
}

.page-header {
  margin-bottom: 40rpx;
  padding: 20rpx 0;
  animation: fadeIn 0.6s ease-out;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: 28rpx;
  color: #999;
  display: block;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  background: white;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.08);
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e2e8f0;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #64748b;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  background: white;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.08);
  animation: fadeIn 0.8s ease-out 0.3s both;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  animation: breathe 2s ease-in-out infinite;
}

.empty-text {
  font-size: 32rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #94a3b8;
  margin-bottom: 40rpx;
}

.start-btn {
  width: 300rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
}

.start-btn::after {
  border: none;
}

.start-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.4);
}

/* 提交记录列表 */
.submission-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  animation: fadeInUp 0.6s ease-out 0.4s both;
}

.submission-item {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  overflow: hidden;
}

.submission-item:nth-child(1) {
  animation: fadeInUp 0.5s ease-out 0.6s both;
}

.submission-item:nth-child(2) {
  animation: fadeInUp 0.5s ease-out 0.7s both;
}

.submission-item:nth-child(3) {
  animation: fadeInUp 0.5s ease-out 0.8s both;
}

.submission-item:nth-child(4) {
  animation: fadeInUp 0.5s ease-out 0.9s both;
}

.submission-item:nth-child(5) {
  animation: fadeInUp 0.5s ease-out 1.0s both;
}

.submission-item:active {
  transform: translateY(-4rpx);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.12);
}

.submission-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.submission-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  flex: 1;
  transition: color 0.3s ease;
}

.submission-item:active .submission-title {
  color: #667eea;
}

.submission-status {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

.submission-item:active .submission-status {
  transform: scale(1.1);
}

.submission-status.status-correct {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.25);
}

.submission-status.status-partial {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.25);
}

.submission-status.status-wrong {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(239, 68, 68, 0.25);
}

.submission-status.status-pending {
  background: #f3f4f6;
  color: #6b7280;
}

.submission-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.submission-time {
  font-size: 24rpx;
  color: #64748b;
  flex-shrink: 0;
}

.submission-score {
  font-size: 32rpx;
  font-weight: 700;
  color: #6366f1;
  transition: color 0.3s ease;
}

.submission-item:active .submission-score {
  color: #667eea;
}

.load-more {
  text-align: center;
  padding: 40rpx 0;
  color: #94a3b8;
  font-size: 28rpx;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes breathe {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}