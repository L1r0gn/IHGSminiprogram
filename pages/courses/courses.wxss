/* pages/courses/courses.wxss - 设计风格优化版 */
page {
  background-color: #f5f7fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.page-container {
  min-height: 100vh;
}

.content-wrapper {
  padding: 40rpx;
}

.page-header {
  margin-bottom: 40rpx;
  padding: 20rpx 0;
  animation: fadeIn 0.6s ease-out;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: 28rpx;
  color: #999;
  display: block;
}

/* 创建课程按钮 */
.create-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.create-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent, rgba(255,255,255,0.1), transparent);
  transform: rotate(45deg) translateX(-100%);
  transition: transform 0.6s ease;
}

.create-btn:active {
  transform: translateY(-4rpx) scale(1.02);
  box-shadow: 0 12rpx 32rpx rgba(102, 126, 234, 0.4);
}

.create-btn:active::before {
  transform: rotate(45deg) translateX(100%);
}

.btn-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  animation: breathe 3s ease-in-out infinite;
}

.btn-text {
  flex: 1;
}

.btn-title {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.btn-desc {
  font-size: 24rpx;
  opacity: 0.9;
  display: block;
}

.btn-arrow {
  font-size: 36rpx;
  font-weight: bold;
  transition: transform 0.3s ease;
}

.create-btn:active .btn-arrow {
  transform: translateX(8rpx);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  background: white;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.08);
  animation: fadeInUp 0.8s ease-out both;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  animation: breathe 2s ease-in-out infinite;
  filter: drop-shadow(0 4rpx 12rpx rgba(102, 126, 234, 0.3));
}

.empty-text {
  font-size: 32rpx;
  color: #64748b;
  margin-bottom: 40rpx;
  font-weight: 500;
}

.empty-tip {
  font-size: 24rpx;
  color: #94a3b8;
  display: block;
  margin-top: 16rpx;
}

.join-btn {
  width: 300rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.join-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
  transition: left 0.5s ease;
}

.join-btn:active::before {
  left: 100%;
}

.join-btn::after {
  border: none;
}

.join-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4);
}

/* 课程列表 */
.course-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 教师端课程卡片 */
.course-item {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  animation: fadeInUp 0.5s ease-out both;
}

.course-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
}

.course-item:nth-child(1) { animation-delay: 0.1s; }
.course-item:nth-child(2) { animation-delay: 0.2s; }
.course-item:nth-child(3) { animation-delay: 0.3s; }
.course-item:nth-child(4) { animation-delay: 0.4s; }
.course-item:nth-child(5) { animation-delay: 0.5s; }

.course-item:active {
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.12);
}

/* 学生端课程卡片 */
.course-item.student-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: white;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  border-left: none;
  animation: fadeInUp 0.5s ease-out both;
}

.course-item.student-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.05) 0%, rgba(118, 75, 162, 0.05) 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.course-item.student-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.course-item.student-card:active {
  transform: translateY(-8rpx) scale(1.02);
  box-shadow: 0 16rpx 48rpx rgba(102, 126, 234, 0.3);
}

.course-item.student-card:active::before {
  opacity: 1;
}

.course-item.student-card:active::after {
  opacity: 1;
}

.course-item.student-card .course-arrow {
  font-size: 40rpx;
  color: #cbd5e1;
  margin-left: 24rpx;
  transition: transform 0.3s ease;
}

.course-item.student-card:active .course-arrow {
  transform: translateX(10rpx);
  color: #667eea;
}

.course-item.student-card .course-name {
  color: #1e293b;
  transition: color 0.3s ease;
}

.course-item.student-card:active .course-name {
  color: #667eea;
}

.course-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 25rpx;
}

.course-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.course-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
  margin-bottom: 8rpx;
  transition: color 0.3s ease;
}

.course-item.student-card .course-name {
  color: #1e293b;
  font-size: 36rpx;
}

.course-item.student-card:active .course-name {
  color: #667eea;
}

.course-code {
  font-size: 24rpx;
  color: #64748b;
  display: block;
  background: #f1f5f9;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  width: fit-content;
}

.course-stats {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.25);
}

.student-count {
  font-size: 24rpx;
  color: white;
  font-weight: 600;
}

/* 学生端卡片描述样式 */
.course-desc {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.teacher,
.count {
  font-size: 26rpx;
  color: #64748b;
}

.course-arrow {
  font-size: 40rpx;
  color: #cbd5e1;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  background: #f8fafc;
  border: none;
  border-radius: 16rpx;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #475569;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.action-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  transform: translateY(-4rpx) scale(1.05);
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.2);
  background: #f1f5f9;
  color: #667eea;
}

.action-btn:active::before {
  opacity: 1;
}

.action-btn .btn-icon {
  font-size: 40rpx;
  margin-right: 0;
  animation: none;
}

.student-btn:active .btn-icon {
  animation: breathe 1s ease-in-out;
}

.homework-btn:active .btn-icon {
  animation: spin 0.5s ease-in-out;
}

.detail-btn:active .btn-icon {
  animation: fadeInUp 0.3s ease-in-out;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  background: white;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.08);
  animation: fadeIn 0.5s ease-out;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e2e8f0;
  border-top-color: #667eea;
  border-right-color: #764ba2;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #64748b;
  font-weight: 500;
}

/* 模态框样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 9999;
  animation: fadeIn 0.3s ease-out;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4rpx);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.9);
  background: white;
  border-radius: 28rpx;
  width: 85%;
  max-width: 600rpx;
  max-height: 80vh;
  overflow: hidden;
  box-shadow: 0 24rpx 48rpx rgba(0, 0, 0, 0.2);
  animation: modalIn 0.3s ease-out forwards;
}

@keyframes modalIn {
  from {
    transform: translate(-50%, -50%) scale(0.9);
    opacity: 0;
  }
  to {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #f1f5f9;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.05) 0%, rgba(118, 75, 162, 0.05) 100%);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.modal-close {
  font-size: 40rpx;
  color: #94a3b8;
  padding: 8rpx;
  line-height: 1;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.modal-close:active {
  background: #f1f5f9;
  color: #667eea;
  transform: rotate(90deg);
}

.modal-body {
  padding: 32rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 16rpx;
}

.form-input,
.form-textarea {
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  font-size: 28rpx;
  background: #fafbfc;
  transition: all 0.3s ease;
  width: 100%;
  box-sizing: border-box;
}

.form-input:focus,
.form-textarea:focus {
  border-color: #667eea;
  background: white;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.1);
}

.form-textarea {
  height: 140rpx;
  resize: none;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 0 32rpx 32rpx;
}

.modal-btn {
  flex: 1;
  border: none;
  border-radius: 16rpx;
  padding: 28rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.modal-btn::after {
  border: none;
}

.cancel-btn {
  background: #f1f5f9;
  color: #64748b;
}

.cancel-btn:active {
  background: #e2e8f0;
  transform: scale(0.95);
}

.confirm-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.confirm-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.4);
}

.textarea-wrapper {
  position: relative;
  width: 100%;
}

.word-count {
  position: absolute;
  right: 20rpx;
  bottom: 12rpx;
  font-size: 24rpx;
  color: #94a3b8;
  z-index: 1;
  font-weight: 500;
}

/* 动画定义 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes breathe {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

@keyframes slideInRight {
  from {
    transform: translateX(100%);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

@keyframes slideOutLeft {
  from {
    transform: translateX(0);
    opacity: 1;
  }
  to {
    transform: translateX(-100%);
    opacity: 0;
  }
}
